{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>Giskard-AI/.github",
        ":pinOnlyDevDependencies"
    ],
    "packageRules": [
        {
            "rangeStrategy": "widen",
            "matchManagers": [
                "pep621"
            ]
        },
        {
            "matchPackageNames": [
                "python"
            ],
            "enabled": false
        }
    ]
}
