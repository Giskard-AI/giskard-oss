{
    "schedule": [
        "before 4am on Monday"
    ],
    "labels": [
        "dependencies"
    ],
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":pinOnlyDevDependencies"
    ],
    "packageRules": [
        {
            "groupName": "{{manager}} dependencies",
            "groupSlug": "{{manager}}-deps",
            "matchUpdateTypes": [
                "*"
            ],
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "matchPackageNames": [
                "python"
            ],
            "enabled": false
        },
        {
            "description": "Group giskard-core dependencies",
            "matchPaths": [
                "libs/giskard-core/**"
            ],
            "groupName": "giskard-core dependencies",
            "groupSlug": "giskard-core-deps"
        }
    ]
}

